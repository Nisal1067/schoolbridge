rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ======================================================================
    // Helpers
    // ======================================================================
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveTeacher() {
      return signedIn()
        && userData().active == true
        && userData().role == 'teacher';
    }

    function isActiveAdmin() {
      return signedIn()
        && userData().active == true
        && userData().role == 'admin';
    }

    function active() { return signedIn() && userData().active == true; }

    function isStudent() {
      return active() && userData().role == 'student';
    }

    function isParent() {
      return active() && userData().role == 'parent';
    }

    // Parents may read homework and announcements of their own school.
    function parentInSchool(schoolId) {
      return isParent() && userData().schoolId == schoolId;
    }

    // The signed-in student's own students/{uid} record.
    function studentRecord() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }

    function teaches(classId, schoolId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isActiveTeacher() && userData().schoolId == schoolId
        && classroom.schoolId == schoolId
        && (classroom.get('teacherId', '') == request.auth.uid
          || request.auth.uid in classroom.get('teacherIds', []));
    }

    // Homework is visible to students in the same class and school.
    function studentSeesClass(classId, schoolId) {
      return isStudent()
        && userData().schoolId == schoolId
        && studentRecord().schoolId == schoolId
        && studentRecord().classId == classId;
    }

    function linked(studentId, schoolId) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      return active() && userData().schoolId == schoolId && student.schoolId == schoolId
        && ((userData().role == 'student' && studentId == request.auth.uid)
          || (userData().role == 'parent' && request.auth.uid in student.parentIds));
    }

    function validAttendance(data) {
      let student = get(/databases/$(database)/documents/students/$(data.studentId)).data;
      return data.keys().hasAll(['studentId', 'studentName', 'classId', 'schoolId', 'teacherId', 'date', 'status', 'term', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'classId', 'schoolId', 'teacherId', 'date', 'status', 'term', 'updatedAt'])
        && data.studentName is string && data.teacherId == request.auth.uid
        && teaches(data.classId, data.schoolId)
        && student.classId == data.classId && student.schoolId == data.schoolId
        && data.studentName == student.name && data.date is timestamp
        && data.status in ['P', 'A', 'L'] && data.term is int && data.term >= 1 && data.term <= 3
        && data.updatedAt == request.time;
    }

    // ======================================================================
    // Classes, students, users
    // ======================================================================
    match /classes/{classId} {
      // Parents fetch the class referenced by their linked student's profile.
      allow get: if isParent() && resource.data.schoolId == userData().schoolId;
      allow read: if isActiveAdmin() || (isActiveTeacher()
        && resource.data.schoolId == userData().schoolId
        && (resource.data.get('teacherId', '') == request.auth.uid
          || request.auth.uid in resource.data.get('teacherIds', [])));
      allow write: if isActiveAdmin();
    }

    match /students/{studentId} {
      allow read: if isActiveAdmin() || (active() && resource.data.schoolId == userData().schoolId
        && ((userData().role == 'student' && studentId == request.auth.uid)
          || (userData().role == 'parent' && request.auth.uid in resource.data.parentIds)
          || teaches(resource.data.classId, resource.data.schoolId)));
      allow write: if isActiveAdmin();
    }

    // SECURITY: users may only update their own profile while role, active
    // and schoolId stay unchanged; only admins can change those.
    match /users/{uid} {
      allow get: if signedIn() && (
        request.auth.uid == uid || 
        isActiveAdmin() || 
        (active() && resource.data.schoolId == userData().schoolId)
      );
      allow list, create, delete: if isActiveAdmin();
      allow update: if isActiveAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'active', 'schoolId', 'classId', 'class', 'gradeOrClass']));
    }

    function validChatPair(data) {
      let teacher = get(/databases/$(database)/documents/users/$(data.teacherId)).data;
      let parent = get(/databases/$(database)/documents/users/$(data.parentId)).data;
      let child = get(/databases/$(database)/documents/students/$(data.studentId)).data;
      let classroom = get(/databases/$(database)/documents/classes/$(data.classId)).data;
      return active() && request.auth.uid in data.participantIds
        && teacher.active == true && teacher.role == 'teacher'
        && parent.active == true && parent.role == 'parent'
        && teacher.schoolId == data.schoolId && parent.schoolId == data.schoolId
        && child.schoolId == data.schoolId && child.classId == data.classId
        && data.parentId in child.get('parentIds', [])
        && classroom.schoolId == data.schoolId
        && (classroom.get('teacherId', '') == data.teacherId
          || data.teacherId in classroom.get('teacherIds', []));
    }

    match /chats/{chatId} {
      allow get: if active() && !exists(/databases/$(database)/documents/chats/$(chatId))
        && userData().role in ['teacher', 'parent'];
      allow read: if active() && userData().role in ['teacher', 'parent']
        && request.auth.uid in resource.data.participantIds;
      allow create: if validChatPair(request.resource.data)
        && chatId == request.resource.data.teacherId + '_' + request.resource.data.parentId
        && request.resource.data.keys().hasOnly(['schoolId', 'teacherId', 'parentId',
          'studentId', 'classId', 'participantIds', 'lastMessage', 'lastMessageAt'])
        && request.resource.data.participantIds == [request.resource.data.teacherId, request.resource.data.parentId]
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageAt == request.time;
      allow update: if validChatPair(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'lastMessageAt'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0 && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        function chat() { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
        function validAttachment(data) {
          return !('attachment' in data) || (
            data.attachment is map
            && data.attachment.keys().hasAll(['path', 'name', 'size', 'contentType', 'provider'])
            && data.attachment.keys().hasOnly(['path', 'name', 'size', 'contentType', 'provider'])
            && data.attachment.path == 'chats/' + chatId + '/' + request.auth.uid + '/' + messageId + '/attachment'
            && data.attachment.name is string && data.attachment.name.size() > 0 && data.attachment.name.size() <= 255
            && data.attachment.size is int && data.attachment.size > 0 && data.attachment.size <= 10 * 1024 * 1024
            && data.attachment.contentType in ['image/jpeg', 'image/png', 'application/pdf', 'text/plain',
              'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
            && data.attachment.provider == 'cloudinary'
              && get(/databases/$(database)/documents/chats/$(chatId)/attachmentUploads/$(messageId)).data.state == 'ready'
              && get(/databases/$(database)/documents/chats/$(chatId)/attachmentUploads/$(messageId)).data.uid == request.auth.uid
              && get(/databases/$(database)/documents/chats/$(chatId)/attachmentUploads/$(messageId)).data.attachment == data.attachment);
        }
        allow read: if active() && userData().role in ['teacher', 'parent']
          && request.auth.uid in chat().participantIds;
        allow create: if validChatPair(chat())
          && request.resource.data.keys().hasAll(['senderId', 'text', 'sentAt'])
          && request.resource.data.keys().hasOnly(['senderId', 'text', 'sentAt', 'attachment'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && (request.resource.data.text.size() > 0 || 'attachment' in request.resource.data)
          && request.resource.data.text.size() <= 2000 && validAttachment(request.resource.data)
          && request.resource.data.sentAt == request.time;
        // Identical retries are safe after an uncertain network acknowledgement.
        allow update: if validChatPair(chat()) && resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sentAt'])
          && request.resource.data.sentAt == request.time;
        allow delete: if false;
      }
      // Only the trusted attachment API may create upload receipts.
      match /attachmentUploads/{messageId} {
        allow read, write: if false;
      }
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow write: if isActiveAdmin() || isActiveTeacher();
    }

    // ======================================================================
    // Attendance
    // ======================================================================
    match /attendance/{attendanceId} {
      allow create: if validAttendance(request.resource.data);
      allow update: if validAttendance(request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.date == resource.data.date;
      allow read: if teaches(resource.data.classId, resource.data.schoolId)
        || linked(resource.data.studentId, resource.data.schoolId);
      allow delete: if teaches(resource.data.classId, resource.data.schoolId);
    }

    // ======================================================================
    // Homework (teacher + student)
    // ======================================================================
    function homeworkFields(data) {
      return data.keys().hasAll(['schoolId', 'classId', 'className', 'teacherId',
          'subject', 'title', 'description', 'dueDate', 'totalStudents',
          'submittedCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schoolId', 'classId', 'className', 'teacherId',
          'subject', 'title', 'description', 'dueDate', 'totalStudents',
          'submittedCount', 'createdAt', 'updatedAt'])
        && data.teacherId == request.auth.uid
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 60
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.className is string
        && data.dueDate is timestamp
        && data.totalStudents is int && data.totalStudents >= 0
        && data.submittedCount is int && data.submittedCount >= 0
        && data.updatedAt == request.time;
    }

    match /homework/{homeworkId} {
      allow read: if (isActiveTeacher()
          && resource.data.teacherId == request.auth.uid
          && resource.data.schoolId == userData().schoolId)
        || studentSeesClass(resource.data.classId, resource.data.schoolId)
        // Parents: the app only queries their children's classes.
        || parentInSchool(resource.data.schoolId);

      allow create: if homeworkFields(request.resource.data)
        && teaches(request.resource.data.classId, request.resource.data.schoolId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedCount == 0;

      allow update: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && homeworkFields(request.resource.data)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.className == resource.data.className
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.totalStudents == resource.data.totalStudents
        && request.resource.data.submittedCount == resource.data.submittedCount;

      allow delete: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;

      // ---- Submissions: homework/{homeworkId}/submissions/{studentId} ------
      match /submissions/{studentId} {
        function homeworkData() {
          return get(/databases/$(database)/documents/homework/$(homeworkId)).data;
        }

        function ownsHomework() {
          return isActiveTeacher()
            && homeworkData().teacherId == request.auth.uid;
        }

        // The signed-in student, working on their own submission.
        function mine() {
          return isStudent() && studentId == request.auth.uid;
        }

        function validNewSubmission(data) {
          return data.keys().hasAll(['studentId', 'studentName', 'status', 'note', 'submittedAt'])
            && data.keys().hasOnly(['studentId', 'studentName', 'status', 'note', 'submittedAt'])
            && data.studentId == request.auth.uid
            && data.studentName == studentRecord().name
            && data.status == 'submitted'
            && data.note is string && data.note.size() <= 2000
            && data.submittedAt == request.time
            && homeworkData().classId == studentRecord().classId
            && homeworkData().schoolId == studentRecord().schoolId;
        }

        // Uses the path ({studentId}), not resource.data, so a student can
        // also read a submission that does not exist yet (shows "Pending").
        // Parents: only their own children's submissions (students/{id}.parentIds).
        allow read: if ownsHomework() || mine()
          || (isParent() && linked(studentId, homeworkData().schoolId));

        allow create: if mine() && validNewSubmission(request.resource.data);

        allow update:
          // Teacher: add a review. Nothing the student wrote may change.
          if (ownsHomework()
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['status', 'feedback', 'reviewedAt'])
              && request.resource.data.status == 'reviewed'
              && request.resource.data.feedback is string
              && request.resource.data.feedback.size() <= 1000
              && request.resource.data.reviewedAt == request.time)
          // Student: resubmit until the teacher has reviewed it.
          || (mine()
              && resource.data.status == 'submitted'
              && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['note', 'submittedAt'])
              && request.resource.data.note is string
              && request.resource.data.note.size() <= 2000
              && request.resource.data.submittedAt == request.time);

        // Needed so deleting a homework can also clear its submissions.
        allow delete: if ownsHomework();
      }
    }

    // ======================================================================
    // Announcements (admin + teacher + student) - ONE block only
    // ======================================================================
    function announcementShape(data) {
      return data.keys().hasAll(['schoolId', 'teacherId', 'title', 'body', 'audience',
          'audienceType', 'classId', 'priority', 'publishAt', 'createdAt'])
        && data.keys().hasOnly(['schoolId', 'teacherId', 'title', 'body', 'audience',
          'audienceType', 'classId', 'priority', 'publishAt', 'createdAt'])
        && data.teacherId == request.auth.uid
        && isActiveTeacher() && userData().schoolId == data.schoolId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
        && data.audience is string
        && data.audienceType in ['all_students', 'parents', 'teachers', 'class']
        && data.priority in ['normal', 'important', 'urgent']
        && data.publishAt is timestamp
        && ((data.audienceType == 'class' && teaches(data.classId, data.schoolId))
          || (data.audienceType != 'class' && data.classId == ''));
    }

    match /announcements/{announcementId} {
      allow read: if isActiveAdmin()
        || (isActiveTeacher()
          && resource.data.teacherId == request.auth.uid
          && resource.data.schoolId == userData().schoolId)
        // Students: announcements for all students, or for their own class.
        || (isStudent()
          && userData().schoolId == resource.data.schoolId
          && (resource.data.audienceType == 'all_students'
            || (resource.data.audienceType == 'class'
              && studentRecord().classId == resource.data.classId)))
        // Parents: announcements for parents, for all students, or for a class
        // (the app only queries their children's classes).
        || (parentInSchool(resource.data.schoolId)
          && resource.data.audienceType in ['parents', 'all_students', 'class']);

      // Admins keep full control, as before.
      allow create, update, delete: if isActiveAdmin();

      allow create: if announcementShape(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Edit: same owner and school, original createdAt kept.
      allow update: if resource.data.teacherId == request.auth.uid
        && announcementShape(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
    }

  }
}
