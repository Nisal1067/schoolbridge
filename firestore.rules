rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActiveTeacher() {
      return signedIn()
        && userData().active == true
        && userData().role == 'teacher';
    }

    function active() { return signedIn() && userData().active == true; }
    function teaches(classId, schoolId) {
      let classroom = get(/databases/$(database)/documents/classes/$(classId)).data;
      return isActiveTeacher() && userData().schoolId == schoolId
        && classroom.schoolId == schoolId && classroom.teacherId == request.auth.uid;
    }
    function linked(studentId, schoolId) {
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      return active() && userData().schoolId == schoolId && student.schoolId == schoolId
        && ((userData().role == 'student' && studentId == request.auth.uid)
          || (userData().role == 'parent' && request.auth.uid in student.parentIds));
    }
    function validAttendance(data) {
      let student = get(/databases/$(database)/documents/students/$(data.studentId)).data;
      return data.keys().hasAll(['studentId', 'studentName', 'classId', 'schoolId', 'teacherId', 'date', 'status', 'term', 'updatedAt'])
        && data.keys().hasOnly(['studentId', 'studentName', 'classId', 'schoolId', 'teacherId', 'date', 'status', 'term', 'updatedAt'])
        && data.studentName is string && data.teacherId == request.auth.uid
        && teaches(data.classId, data.schoolId)
        && student.classId == data.classId && student.schoolId == data.schoolId
        && data.studentName == student.name && data.date is timestamp
        && data.status in ['P', 'A', 'L'] && data.term is int && data.term >= 1 && data.term <= 3
        && data.updatedAt == request.time;
    }

    match /classes/{classId} {
      allow read: if isActiveTeacher() && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
      allow write: if false;
    }
    match /students/{studentId} {
      allow read: if active() && resource.data.schoolId == userData().schoolId
        && ((userData().role == 'student' && studentId == request.auth.uid)
          || (userData().role == 'parent' && request.auth.uid in resource.data.parentIds)
          || teaches(resource.data.classId, resource.data.schoolId));
      allow write: if false;
    }

    function isActiveAdmin() {
      return signedIn()
        && userData().active == true
        && userData().role == 'admin';
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if isActiveAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow write: if isActiveAdmin() || isActiveTeacher();
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow write: if isActiveAdmin() || isActiveTeacher();
    }

    match /attendance/{attendanceId} {
      allow create: if validAttendance(request.resource.data);
      allow update: if validAttendance(request.resource.data)
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.date == resource.data.date;
      allow read: if teaches(resource.data.classId, resource.data.schoolId)
        || linked(resource.data.studentId, resource.data.schoolId);
      allow delete: if teaches(resource.data.classId, resource.data.schoolId);
    }

    function homeworkFields(data) {
      return data.keys().hasAll(['schoolId', 'classId', 'className', 'teacherId',
          'subject', 'title', 'description', 'dueDate', 'totalStudents',
          'submittedCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['schoolId', 'classId', 'className', 'teacherId',
          'subject', 'title', 'description', 'dueDate', 'totalStudents',
          'submittedCount', 'createdAt', 'updatedAt'])
        && data.teacherId == request.auth.uid
        && data.subject is string && data.subject.size() > 0 && data.subject.size() <= 60
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.description is string && data.description.size() <= 2000
        && data.className is string
        && data.dueDate is timestamp
        && data.totalStudents is int && data.totalStudents >= 0
        && data.submittedCount is int && data.submittedCount >= 0
        && data.updatedAt == request.time;
    }
 
    match /homework/{homeworkId} {
      allow read: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
 
      allow create: if homeworkFields(request.resource.data)
        && teaches(request.resource.data.classId, request.resource.data.schoolId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.submittedCount == 0;
 
      allow update: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && homeworkFields(request.resource.data)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.className == resource.data.className
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.totalStudents == resource.data.totalStudents
        && request.resource.data.submittedCount == resource.data.submittedCount;
 
      allow delete: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
 
      // ---- Submissions: homework/{homeworkId}/submissions/{studentId} ------
      // Students will get create/update access when the student side is built.
      match /submissions/{studentId} {
        function ownsHomework() {
          return isActiveTeacher()
            && get(/databases/$(database)/documents/homework/$(homeworkId)).data.teacherId == request.auth.uid;
        }
 
        allow read: if ownsHomework();
 
        // Teacher can only add a review; nothing the student wrote may change.
        allow update: if ownsHomework()
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'feedback', 'reviewedAt'])
          && request.resource.data.status == 'reviewed'
          && request.resource.data.feedback is string
          && request.resource.data.feedback.size() <= 1000
          && request.resource.data.reviewedAt == request.time;
 
        // Needed so deleting a homework can also clear its submissions.
        allow delete: if ownsHomework();
      }
    }

    function announcementShape(data) {
      return data.keys().hasAll(['schoolId', 'teacherId', 'title', 'body', 'audience',
          'audienceType', 'classId', 'priority', 'publishAt', 'createdAt'])
        && data.keys().hasOnly(['schoolId', 'teacherId', 'title', 'body', 'audience',
          'audienceType', 'classId', 'priority', 'publishAt', 'createdAt'])
        && data.teacherId == request.auth.uid
        && isActiveTeacher() && userData().schoolId == data.schoolId
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && data.body is string && data.body.size() > 0 && data.body.size() <= 2000
        && data.audience is string
        && data.audienceType in ['all_students', 'parents', 'teachers', 'class']
        && data.priority in ['normal', 'important', 'urgent']
        && data.publishAt is timestamp
        && ((data.audienceType == 'class' && teaches(data.classId, data.schoolId))
          || (data.audienceType != 'class' && data.classId == ''));
    }
 
    match /announcements/{announcementId} {
      allow read: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
 
      allow create: if announcementShape(request.resource.data)
        && request.resource.data.createdAt == request.time;
 
      // Edit: same owner and school, original createdAt kept.
      allow update: if resource.data.teacherId == request.auth.uid
        && announcementShape(request.resource.data)
        && request.resource.data.schoolId == resource.data.schoolId
        && request.resource.data.createdAt == resource.data.createdAt;
 
      allow delete: if isActiveTeacher()
        && resource.data.teacherId == request.auth.uid
        && resource.data.schoolId == userData().schoolId;
    }

      }
}
