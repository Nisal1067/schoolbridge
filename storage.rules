rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{chatId}/{senderId}/{messageId}/attachment {
      function profile(uid) {
        return firestore.get(/databases/(default)/documents/users/$(uid)).data;
      }
      function chat() {
        return firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
      }
      function member() {
        return request.auth != null && profile(request.auth.uid).active == true
          && profile(request.auth.uid).role in ['teacher', 'parent']
          && request.auth.uid in chat().participantIds;
      }
      allow read: if member();
      // Only two Firestore documents may be read by a Storage rule evaluation.
      // Firestore verifies the current class/parent relationship when sending.
      allow create: if member() && senderId == request.auth.uid
        && request.resource.size > 0 && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf', 'text/plain',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'];
      allow update: if false;
      // Cleanup checks only the owner profile and message (two documents).
      allow delete: if request.auth != null && senderId == request.auth.uid
        && profile(request.auth.uid).active == true
        && !firestore.exists(/databases/(default)/documents/chats/$(chatId)/messages/$(messageId));
    }
    
    match /profile-photos/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size > 0 && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
